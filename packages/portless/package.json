{
  "name": "@variablelab/portless",
  "version": "0.0.6",
  "description": "Fork of vercel-labs/portless with path-based routing (--path). Replace port numbers with stable, named .localhost URLs and route several apps under one hostname by URL prefix.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "portless": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "cp ../../README.md ../../LICENSE ../../NOTICE . && pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "local",
    "development",
    "proxy",
    "localhost",
    "path-based-routing",
    "reverse-proxy",
    "dev-server",
    "https",
    "monorepo",
    "portless"
  ],
  "author": "Vercel Labs",
  "contributors": [
    {
      "name": "Ricardo Q. Bazan",
      "email": "ricardo@variable.land",
      "url": "https://github.com/rqbazan"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withvariablelab/portless.git",
    "directory": "packages/portless"
  },
  "homepage": "https://github.com/withvariablelab/portless#readme",
  "bugs": {
    "url": "https://github.com/withvariablelab/portless/issues"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
